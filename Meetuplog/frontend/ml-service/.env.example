TMDB_API_TOKEN=
# v3 API Key를 쓸 경우 위 값을 비우고 아래에 입력할 수도 있습니다.
TMDB_API_KEY=
KOBIS_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
KOBIS_BASE_URL=https://www.kobis.or.kr/kobisopenapi/webservice/rest
# 선택 사항: 작품별 OTT 직접 주소를 제공하려면 Watchmode API 키를 입력합니다.
# 키가 없으면 국내 OTT 검색 페이지로 안전하게 연결됩니다.
WATCHMODE_API_KEY=
WATCHMODE_BASE_URL=https://api.watchmode.com/v1
WATCHMODE_REGION=KR
WATCHMODE_TIMEOUT_SECONDS=4.0
MEETUP_DATA_DIR=./data
MEETUP_MODEL_DIR=./models
MEETUP_DB_BACKEND=sqlite
MEETUP_DB_PATH=./data/meetup_runtime.db
MEETUP_REQUEST_INTERVAL_SECONDS=0.25
MEETUP_MAX_RETRIES=3
MEETUP_MODEL_NAME=jhgan/ko-sroberta-multitask
# sentence-transformers와 로컬 모델 캐시가 있으면 true로 변경하세요.
# 기본 false에서도 word/character TF-IDF 의미 유사도 fallback이 동작합니다.
MEETUP_USE_EMBEDDING=false
MEETUP_USE_TYPO_MODEL=false
MEETUP_USE_SPACER_MODEL=false
MEETUP_REALTIME_HEAVY_CORRECTION=false
